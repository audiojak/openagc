<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Development builds signed with the self-signed "OpenAGC Dev" identity
  (scripts/dev-signing.sh). That identity has no Team ID, so the hardened
  runtime's library validation would refuse the app's own debug dylib;
  turn it off here only. Release builds use OpenAGC.entitlements.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
